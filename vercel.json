{
  "redirects": [
    {
      "source": "/",
      "destination": "/typing-trainer/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/typing-trainer/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
